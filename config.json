{
  "theme": "default",
  "default_font_size": 16,
  "font_size_step": 4,
  "notes_dir": "~/Documents/Mimenotes",
  "keybindings": {
    "new_tab": "ff+t",
    "new_tab_alt": "Ctrl+T",
    "close_tab": "Ctrl+W",
    "reopen_closed_tab": "Ctrl+Shift+T",
    "save": "Ctrl+S",
    "rename_tab": "ff+r",
    "rename_tab_alt": "F2",
    "next_tab": "ff+k",
    "next_tab_alt": "Ctrl+Tab",
    "prev_tab": "ff+j",
    "prev_tab_alt": "Ctrl+Shift+Tab",
    "zoom_in": "Ctrl+=",
    "zoom_out": "Ctrl+-",
    "zoom_reset": "Ctrl+0",
    "divider_trigger": "---",
    "delete_line_trigger": "dd",
    "delete_line_timeout_ms": 350,
    "search_trigger": "//",
    "search_timeout_ms": 350,
    "leader_trigger": "jj",
    "leader_timeout_ms": 350,
    "tab_leader_trigger": "ff",
    "tab_leader_timeout_ms": 350,
    "reset_format_key": "h",
    "highlight_mode_key": "u",
    "color_keys": [
      "j",
      "k",
      "l",
      ";"
    ],
    "format_keys": [
      "a",
      "s",
      "d",
      "f"
    ]
  }
}
