{
  "theme": "default",
  "default_font_size": 16,
  "font_size_step": 4,
  "notes_dir": "~/Notes",
  "keybindings": {
    "new_tab": "Ctrl+T",
    "new_tab_alt": "Ctrl+N",
    "close_tab": "Ctrl+W",
    "reopen_closed_tab": "Ctrl+Shift+T",
    "save": "Ctrl+S",
    "rename_tab": "F2",
    "rename_tab_alt": "Ctrl+R",
    "next_tab": "Ctrl+Tab",
    "next_tab_alt": "Ctrl+PgDown",
    "prev_tab": "Ctrl+Shift+Tab",
    "prev_tab_alt": "Ctrl+PgUp",
    "zoom_in": "Ctrl+=",
    "zoom_out": "Ctrl+-",
    "zoom_reset": "Ctrl+0",
    "divider_trigger": "---",
    "leader_trigger": "jj",
    "leader_timeout_ms": 350,
    "new_tab_trigger": "ff",
    "new_tab_timeout_ms": 350,
    "reset_format_key": "h",
    "color_keys": [
      "j",
      "k",
      "l",
      ";"
    ],
    "format_keys": [
      "a",
      "s",
      "d",
      "f"
    ]
  }
}
